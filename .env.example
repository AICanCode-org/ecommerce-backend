# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.
# Every track reads exactly these variables.

# --- app (used when you run a track directly on your machine with `make run`) ---
DATABASE_URL=postgresql://shopflow:shopflow@localhost:5432/shopflow
PORT=8080
# MIGRATIONS_DIR defaults to ../../spec/db/migrations when run from tracks/<track>

# --- auth (Phase 3 M2) ---
# At least 32 bytes. Unset = a random secret per process (tokens die on restart, dev only).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
# bcrypt work factor, 4..15. 10 is a sane laptop default; tests use 4 to stay fast.
BCRYPT_COST=10
# The first admin. Created (or promoted) at startup. Synthetic values for your laptop only.
ADMIN_EMAIL=admin@shopflow.local
ADMIN_PASSWORD=admin-password-123

# --- payments (Phase 3 M5) ---
# Shared secret of the fake payment provider: it signs every webhook body with HMAC-SHA256
# (header X-Signature: sha256=<hex>). At least 32 bytes. Generate one with:  openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=local-webhook-secret-change-me-0123456789

# --- ports published by docker compose (change if something else uses them) ---
APP_PORT=8080
POSTGRES_PORT=5432

# --- AI description drafts + search assist (Phase 3 M3). Default: offline template/rules, no key needed. ---
# Model names and free-tier limits change often: check the provider docs before you copy these.
AI_PROVIDER=offline
# Local + free + offline after the first download:   docker compose --profile ollama up -d
#   AI_PROVIDER=llm  LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=llama3.2:1b
# Google Gemini free tier (OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Groq free tier:
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=
LLM_TIMEOUT_MS=5000
